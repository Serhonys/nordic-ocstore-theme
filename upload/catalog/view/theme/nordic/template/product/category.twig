{{ header }}
<main id="product-category" class="nt-main">
  <div class="nt-wrap">
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    <div class="nt-layout">
      {{ column_left }}
      <div id="content">
        {{ content_top }}
        <div class="nt-title">
          <h1>{{ heading_title }}</h1>
        </div>
        {% if thumb or description %}
        <div class="nt-seo" id="nt-seo">
          {% if thumb %}<img src="{{ thumb }}" alt="{{ heading_title }}" />{% endif %}
          <div class="nt-seo__text">{{ description }}</div>
          <button type="button" id="nt-seo-toggle" data-more="{{ button_continue }}" data-less="{{ button_continue }}">{{ button_continue }}</button>
        </div>
        {% endif %}
        {% if categories %}
        <div class="nt-subcats">
          {% for category in categories %}
          <a href="{{ category.href }}">{{ category.name }}</a>
          {% endfor %}
        </div>
        {% endif %}
        {% if products %}
        <div class="nt-toolbar">
          <button type="button" class="nt-btn nt-filter-open" id="nt-open-filters"><span data-nt="filters"></span></button>
          <a href="{{ compare }}" id="compare-total">{{ text_compare }}</a>
          <label>
            {{ text_sort }}
            <select id="input-sort" onchange="location = this.value;">
              {% for sorts in sorts %}
              {% if sorts.value == '%s-%s'|format(sort, order) %}
              <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
              {% else %}
              <option value="{{ sorts.href }}">{{ sorts.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </label>
          <label>
            {{ text_limit }}
            <select id="input-limit" onchange="location = this.value;">
              {% for limits in limits %}
              {% if limits.value == limit %}
              <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
              {% else %}
              <option value="{{ limits.href }}">{{ limits.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </label>
          <div class="nt-views">
            <button type="button" id="grid-view" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
            <button type="button" id="list-view" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
          </div>
        </div>
        <div class="nt-products" id="nt-products" data-view="grid">
          {% for product in products %}
          <article class="product-layout nt-card product-thumb">
            <div class="nt-card__media">
              {% if product.special %}<div class="nt-card__badges"><span class="nt-pill nt-pill--sale">%</span></div>{% endif %}
              <div class="nt-card__tools">
                <button type="button" class="nt-icon-btn" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart-o"></i></button>
                <button type="button" class="nt-icon-btn" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><i class="fa fa-exchange"></i></button>
              </div>
              <a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" /></a>
            </div>
            <div class="nt-card__body">
              <h3><a href="{{ product.href }}">{{ product.name }}</a></h3>
              {% if product.rating %}
              <div class="rating">{% for i in 1..5 %}{% if product.rating < i %}<i class="fa fa-star-o"></i>{% else %}<i class="fa fa-star"></i>{% endif %}{% endfor %}</div>
              {% endif %}
              {% if product.price %}
              <div class="nt-price">
                {% if not product.special %}{{ product.price }}{% else %}<s>{{ product.price }}</s><span>{{ product.special }}</span>{% endif %}
                {% if product.tax %}<small>{{ text_tax }} {{ product.tax }}</small>{% endif %}
              </div>
              {% endif %}
              <div class="nt-card__buy">
                <button type="button" class="nt-btn" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">{{ button_cart }}</button>
              </div>
            </div>
          </article>
          {% endfor %}
        </div>
        <div class="nt-pages">
          <div>{{ pagination }}</div>
          <div>{{ results }}</div>
        </div>
        {% endif %}
        {% if not categories and not products %}
        <div class="nt-empty">
          <p>{{ text_empty }}</p>
          <a class="nt-btn" href="{{ continue }}">{{ button_continue }}</a>
        </div>
        {% endif %}
        {{ content_bottom }}
      </div>
      {{ column_right }}
    </div>
  </div>
</main>
{{ footer }}

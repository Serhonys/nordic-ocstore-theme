{{ header }}
<main id="product-compare" class="nt-main">
  <div class="nt-wrap">
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    <div class="nt-layout">
      {{ column_left }}
      <div id="content">
        {{ content_top }}
        
<h1>{{ heading_title }}</h1>
{% if products %}
<div style="overflow-x:auto">
<table class="nt-table">
  <thead><tr><td></td>{% for product in products %}<td><a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" /></a><a href="{{ product.href }}">{{ product.name }}</a><br><button type="button" class="nt-btn" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">{{ button_cart }}</button> <a href="{{ product.remove }}">{{ button_remove }}</a></td>{% endfor %}</tr></thead>
  <tbody>
    <tr><td>{{ text_price }}</td>{% for product in products %}<td>{% if not product.special %}{{ product.price }}{% else %}<s>{{ product.price }}</s> {{ product.special }}{% endif %}</td>{% endfor %}</tr>
    <tr><td>{{ text_model }}</td>{% for product in products %}<td>{{ product.model }}</td>{% endfor %}</tr>
    <tr><td>{{ text_manufacturer }}</td>{% for product in products %}<td>{{ product.manufacturer }}</td>{% endfor %}</tr>
    <tr><td>{{ text_availability }}</td>{% for product in products %}<td>{{ product.availability }}</td>{% endfor %}</tr>
    <tr><td>{{ text_rating }}</td>{% for product in products %}<td>{{ product.rating }}</td>{% endfor %}</tr>
    <tr><td>{{ text_summary }}</td>{% for product in products %}<td>{{ product.description }}</td>{% endfor %}</tr>
    <tr><td>{{ text_weight }}</td>{% for product in products %}<td>{{ product.weight }}</td>{% endfor %}</tr>
    <tr><td>{{ text_dimension }}</td>{% for product in products %}<td>{{ product.length }} x {{ product.width }} x {{ product.height }}</td>{% endfor %}</tr>
    {% for attribute_group in attribute_groups %}
    <tr><td colspan="{{ products|length + 1 }}"><strong>{{ attribute_group.name }}</strong></td></tr>
    {% for key, attribute in attribute_group.attribute %}
    <tr><td>{{ attribute.name }}</td>{% for product in products %}<td>{% if product.attribute[key] %}{{ product.attribute[key] }}{% endif %}</td>{% endfor %}</tr>
    {% endfor %}
    {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<div class="nt-empty"><p>{{ text_empty }}</p><a class="nt-btn" href="{{ continue }}">{{ button_continue }}</a></div>
{% endif %}

        {{ content_bottom }}
      </div>
      {{ column_right }}
    </div>
  </div>
</main>
{{ footer }}

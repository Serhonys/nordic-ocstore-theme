{{ header }}
<main id="product-special" class="nt-main">
  <div class="nt-wrap">
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    <div class="nt-layout">
      {{ column_left }}
      <div id="content">
        {{ content_top }}
        <h1>{{ heading_title }}</h1>

{% if products %}
<div class="nt-toolbar">
  <button type="button" class="nt-btn nt-filter-open" id="nt-open-filters"><span data-nt="filters"></span></button>
  {% if compare is defined %}<a href="{{ compare }}" id="compare-total">{{ text_compare }}</a>{% endif %}
  {% if sorts is defined %}
  <label>{{ text_sort }}
    <select id="input-sort" onchange="location = this.value;">
      {% for sorts in sorts %}
      <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected="selected"{% endif %}>{{ sorts.text }}</option>
      {% endfor %}
    </select>
  </label>
  {% endif %}
  {% if limits is defined %}
  <label>{{ text_limit }}
    <select id="input-limit" onchange="location = this.value;">
      {% for limits in limits %}
      <option value="{{ limits.href }}"{% if limits.value == limit %} selected="selected"{% endif %}>{{ limits.text }}</option>
      {% endfor %}
    </select>
  </label>
  {% endif %}
  <div class="nt-views">
    <button type="button" id="grid-view" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
    <button type="button" id="list-view" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
  </div>
</div>
<div class="nt-products" id="nt-products" data-view="grid">
  {% for product in products %}

<article class="product-layout nt-card product-thumb">
  <div class="nt-card__media">
    {% if product.special %}<div class="nt-card__badges"><span class="nt-pill nt-pill--sale">%</span></div>{% endif %}
    <div class="nt-card__tools">
      <button type="button" class="nt-icon-btn" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart-o"></i></button>
      <button type="button" class="nt-icon-btn" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><i class="fa fa-exchange"></i></button>
    </div>
    <a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" /></a>
  </div>
  <div class="nt-card__body">
    <h3><a href="{{ product.href }}">{{ product.name }}</a></h3>
    {% if product.description is defined and product.description %}<p>{{ product.description }}</p>{% endif %}
    {% if product.rating %}
    <div class="rating">{% for i in 1..5 %}{% if product.rating < i %}<i class="fa fa-star-o"></i>{% else %}<i class="fa fa-star"></i>{% endif %}{% endfor %}</div>
    {% endif %}
    {% if product.price %}
    <div class="nt-price">{% if not product.special %}{{ product.price }}{% else %}<s>{{ product.price }}</s><span>{{ product.special }}</span>{% endif %}{% if product.tax %}<small>{{ text_tax }} {{ product.tax }}</small>{% endif %}</div>
    {% endif %}
    <div class="nt-card__buy"><button type="button" class="nt-btn" onclick="cart.add('{{ product.product_id }}'{% if product.minimum is defined %}, '{{ product.minimum }}'{% endif %});">{{ button_cart }}</button></div>
  </div>
</article>

  {% endfor %}
</div>
<div class="nt-pages"><div>{{ pagination }}</div><div>{{ results }}</div></div>
{% endif %}
{% if not products %}<div class="nt-empty"><p>{{ text_empty }}</p><a class="nt-btn" href="{{ continue }}">{{ button_continue }}</a></div>{% endif %}
        {{ content_bottom }}
      </div>
      {{ column_right }}
    </div>
  </div>
</main>
{{ footer }}

{{ header }}
<main id="product-manufacturer" class="nt-main">
  <div class="nt-wrap">
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
    <div class="nt-layout">
      {{ column_left }}
      <div id="content">
        {{ content_top }}
        
<h1>{{ heading_title }}</h1>
{% if categories %}
<div class="nt-tiles">
  {% for category in categories %}
  <div class="nt-tile"><h2>{{ category.name }}</h2><ul>{% for manufacturer in category.manufacturer %}<li><a href="{{ manufacturer.href }}">{{ manufacturer.name }}</a></li>{% endfor %}</ul></div>
  {% endfor %}
</div>
{% else %}
<div class="nt-empty"><p>{{ text_empty }}</p><a class="nt-btn" href="{{ continue }}">{{ button_continue }}</a></div>
{% endif %}

        {{ content_bottom }}
      </div>
      {{ column_right }}
    </div>
  </div>
</main>
{{ footer }}

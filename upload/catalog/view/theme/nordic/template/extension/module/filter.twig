<div class="nt-module">
  <h3>{{ heading_title }}</h3>
  {% for filter_group in filter_groups %}
  <div class="panel"><div class="panel-heading">{{ filter_group.name }}</div><div class="panel-body" id="filter-group{{ filter_group.filter_group_id }}">
    {% for filter in filter_group.filter %}
    <label class="nt-check"><span><input type="checkbox" name="filter[]" value="{{ filter.filter_id }}"{% if filter.filter_id in filter_category %} checked="checked"{% endif %} /> {{ filter.name }}</span></label>
    {% endfor %}
  </div></div>
  {% endfor %}
  <button type="button" id="button-filter" class="nt-btn">{{ button_filter }}</button>
</div>
<script>
$('#button-filter').on('click', function() {
  var filter = [];
  $('input[name^=\'filter\']:checked').each(function() { filter.push(this.value); });
  location = '{{ action|escape('js') }}&filter=' + filter.join(',');
});
</script>
